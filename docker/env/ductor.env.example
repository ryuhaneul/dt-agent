# Bot-only provider and service environment. Copy to $DUCTOR_HOME/.env.
# Provider CLIs normally use OAuth; this key enables Gemini API-key authentication.
GEMINI_API_KEY=

# Credentials that tools take while they run (repository tokens, passwords, seeds) belong in
# $DUCTOR_HOME/secrets.env instead; it is not injected into CLI runs. See docs/config.md.
